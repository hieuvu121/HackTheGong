# Copy to .env.local and edit. Every EXPO_PUBLIC_ var is inlined into the
# bundle at build time, so Metro must be restarted after changing one — a
# reload is not enough. Never put a secret in one; they ship to the client.

# Where the API lives. Inferred from the Metro host when unset, which is right
# for a simulator and for a phone on the same network.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Report from a made-up position near Wollongong instead of the device's own.
#
# For demoing off a simulator, which reports a valid fix in San Francisco and
# drops every report 26,000km off the map. Off by default and deliberately
# awkward to turn on: it also skips the check that a rider is standing within
# 75m of a hazard before marking it fixed, which is the whole point of that
# screen. The gate says outright that it was skipped.
# EXPO_PUBLIC_DEMO_LOCATION=1
