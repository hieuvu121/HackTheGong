# Copy to .env and fill in. Without a key the API still works: photo analysis
# falls back to a clearly-labelled heuristic so the app is demoable offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

PORT=3000
# Where the SQLite file and uploaded photos live, relative to backend/.
DATA_DIR=./data
UPLOAD_DIR=./uploads
